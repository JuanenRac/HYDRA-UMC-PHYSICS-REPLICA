<?xml version="1.0"?>
<robot name="arm_3dof">
  <link name="base"/>
  <link name="turret"/>
  <link name="upper"/>
  <link name="slider"/>
  <joint name="base_yaw" type="revolute">
    <parent link="base"/>
    <child link="turret"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.2" upper="3.2" effort="10" velocity="2"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="turret"/>
    <child link="upper"/>
    <origin xyz="0.05 0 0.2" rpy="0 0.2 0.5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.2" upper="3.2" effort="10" velocity="2"/>
  </joint>
  <joint name="slide" type="prismatic">
    <parent link="upper"/>
    <child link="slider"/>
    <origin xyz="0.3 0 0" rpy="0.1 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.15" effort="10" velocity="2"/>
  </joint>
</robot>
