<?xml version="1.0"?>
<robot name="branch_tree">
  <link name="base"/>
  <link name="trunk"/>
  <link name="left"/>
  <link name="right"/>
  <link name="left_end"/>
  <joint name="spine" type="revolute">
    <parent link="base"/>
    <child link="trunk"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.2" upper="3.2" effort="10" velocity="2"/>
  </joint>
  <joint name="left_arm" type="revolute">
    <parent link="trunk"/>
    <child link="left"/>
    <origin xyz="0 0.2 0.3" rpy="0.4 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.2" upper="3.2" effort="10" velocity="2"/>
  </joint>
  <joint name="right_arm" type="revolute">
    <parent link="trunk"/>
    <child link="right"/>
    <origin xyz="0 -0.2 0.3" rpy="-0.4 0.1 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.2" upper="3.2" effort="10" velocity="2"/>
  </joint>
  <joint name="left_tip" type="fixed">
    <parent link="left"/>
    <child link="left_end"/>
    <origin xyz="0.25 0 0" rpy="0 0 0.3"/>
  </joint>
</robot>
